# Sesión: OBLIGATORIO en producción (Vercel). Sin esto, cada cold start invalida la sesión.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""

# Login admin
AUTH_USERNAME=""
AUTH_PASSWORD=""

# ============================================================
# CALENDARIOS iCal (Airbnb, Booking, etc.)
# ============================================================
# AIRBNB_CALENDAR_URL acepta 2 formatos (auto-detect):
#
# 1. URL simple (legacy, 1 solo calendario):
#      AIRBNB_CALENDAR_URL="https://www.airbnb.com/calendar/ical/X.ics"
#    → calendario_id = "default", nombre = "default"
#
# 2. JSON (multi-calendario, recomendado):
#      AIRBNB_CALENDAR_URL='[
#        {"nombre": "Casa Costa", "source": "airbnb",
#         "url": "https://www.airbnb.com/calendar/ical/X.ics",
#         "imagen": "images/casa-costa.png"},
#        {"nombre": "Casa Cordillera", "source": "airbnb",
#         "url": "https://www.airbnb.cl/calendar/ical/Y.ics",
#         "imagen": "images/casa-cordillera.png"}
#      ]'
#    → calendario_id derivado del nombre slugificado
#      ("Casa Costa" → "casa_costa", "Casa Cordillera" → "casa_cordillera")
#    → si pasás solo "imagen", el código deriva automáticamente:
#         thumbnail = images/casa-costa-thumb.png
#         logo      = images/casa-costa-logo.png
#      También podés pasar "thumbnail" y/o "logo" explícitos por separado.
#
# Plataformas soportadas: airbnb, booking (auto-detect por prefijo de la key).
# URLs deben ser PLACEHOLDERS. Reemplazar antes de deploy.

# Airbnb - calendario principal o multi-calendario JSON
# "imagen" es opcional: si está, el código deriva "<imagen>-thumb" y "<imagen>-logo"
# automáticamente (colocá las versiones correspondientes en airbnb_agent/static/images/).
AIRBNB_CALENDAR_URL='[
  {"nombre": "Casa Costa", "source": "airbnb", "url": "https://example.com/airbnb_casa_costa.ics", "imagen": "images/casa-costa.png"},
  {"nombre": "Casa Cordillera", "source": "airbnb", "url": "https://example.com/airbnb_casa_cordillera.ics", "imagen": "images/casa-cordillera.png"}
]'

# Booking (opcional, mismo formato)
# BOOKING_CALENDAR_URL='[
#   {"nombre": "Casa Santiago", "source": "booking", "url": "https://example.com/booking_casa_santiago.ics"}
# ]'

# Zona horaria de la propiedad (evita desfase en producción UTC). Ej: America/Santiago
TIMEZONE="America/Santiago"

# Owner phone number for logging/display
OWNER_PHONE=""

# Owner WhatsApp JID (e.g., number@s.whatsapp.net) to receive and approve summaries
OWNER_JID=""

# Provider alias from providers.json to use as a mock/real summary recipient
SUMMARY_RECEIVER_ID="tester"

# MercadoPago: para reservatinaja
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Link de pago estático (ej. https://link.mercadopago.cl/posadaenelbosque). Si no se define, usa posadaenelbosque por defecto.
MERCADOPAGO_LINK="https://link.mercadopago.cl/posadaenelbosque"
MERCADOPAGO_WEBHOOK_SECRET=""

# MongoDB (base de datos principal: airbnb-db + bci para transacciones)
MONGODB_URI=""
